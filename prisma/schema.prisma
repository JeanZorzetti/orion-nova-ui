generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== AUTENTICAÇÃO (NextAuth.js) =====

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // Apenas para credenciais locais
  role          UserRole  @default(USER)

  // Password Reset
  resetToken       String?
  resetTokenExpiry DateTime?

  // Trial e Subscription
  subscriptionStatus SubscriptionUserStatus @default(TRIAL)
  trialEndsAt        DateTime?              // Data de expiração do trial (30 dias após registro)

  // Cota mensal da Orion AI. Fica no dono (a cota é da conta, não da pessoa) e
  // zera sozinha quando vira o mês — sem tabela de log e sem cron.
  aiMessagesUsed    Int       @default(0)
  aiMessagesPeriod  String?   // "2026-08": mês a que aiMessagesUsed se refere

  // Equipe. Um membro aponta para o dono da conta; o dono tem ownerId nulo.
  // Todo dado do ERP (Customer, Product, SalesOrder, FinancialTransaction...)
  // continua gravado no id do DONO — é isso que faz os dois usuários enxergarem
  // a mesma empresa sem renomear userId em seis tabelas. Quem paga, tem trial e
  // assinatura é sempre o dono; o membro herda o acesso dele.
  ownerId String?
  owner   User?   @relation("AccountMembers", fields: [ownerId], references: [id], onDelete: Cascade)
  members User[]  @relation("AccountMembers")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  accounts      Account[]
  sessions      Session[]
  subscriptions Subscription[]
  orders        Order[]
  tickets       SupportTicket[]
  posts         Post[]        @relation("PostAuthor")
  customers     Customer[]
  products      Product[]
  salesOrders   SalesOrder[]
  financialTransactions FinancialTransaction[]
  notifications Notification[]
  onboarding    UserOnboarding?
  dataMigrations DataMigration[]
  pushSubscriptions PushSubscription[]
  apiKeys       ApiKey[]
  company       Company?
  notasFiscais  NotaFiscal[]

  @@index([ownerId])
  @@map("users")
}

// Dados cadastrais da empresa do usuário (1:1, como UserOnboarding).
// ponytail: 1 empresa por usuário. Multi-empresa é outra feature, não um
// campo — quando existir, isto vira Company[] + membership.
model Company {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName String   // Razão social
  tradeName   String?  // Nome fantasia
  cnpj        String?  // Somente dígitos
  phone       String?
  email       String?
  website     String?

  address     String?  // Logradouro
  numero      String?
  complemento String?
  bairro      String?
  city        String?
  state       String?  // UF
  zipCode     String?

  // --- Emitente da NF-e ---
  // O regime tributário é a primeira pergunta: ele decide se o produto usa
  // CSOSN (Simples) ou CST (Regime Normal). Sem ele nada mais faz sentido.
  regimeTributario     RegimeTributario?
  inscricaoEstadual    String?
  inscricaoMunicipal   String?
  cnae                 String?
  codigoMunicipioIBGE  String?  // 7 dígitos, tabela do IBGE
  serieNfe             Int      @default(1)
  proximoNumeroNfe     Int      @default(1)
  ambienteNfe          AmbienteFiscal @default(HOMOLOGACAO)
  // ponytail: o .pfx vive no provedor. Guardamos a referência dele e a
  // validade (para avisar o cliente antes de vencer) — nunca o arquivo nem a
  // senha. Se um dia precisar guardar, isso é KMS, não uma coluna.
  certificadoRef       String?
  certificadoValidoAte DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("companies")
}

/// CRT da NF-e: 1, 2, 3 e 4 respectivamente.
enum RegimeTributario {
  SIMPLES_NACIONAL
  SIMPLES_NACIONAL_EXCESSO
  REGIME_NORMAL
  MEI
}

enum AmbienteFiscal {
  HOMOLOGACAO
  PRODUCAO
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum SubscriptionUserStatus {
  TRIAL       // Trial de 30 dias (acesso completo)
  ACTIVE      // Assinatura ativa (paga)
  EXPIRED     // Trial ou assinatura expirada
  CANCELLED   // Assinatura cancelada
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ===== PLANOS E ASSINATURAS =====

model Plan {
  id              String   @id @default(cuid())
  name            String   // Starter, Professional, Enterprise
  slug            String   @unique
  description     String?
  price           Decimal  @db.Decimal(10, 2)
  billingPeriod   BillingPeriod @default(MONTHLY)
  features        Json     // Array de features
  maxUsers        Int?
  maxStorage      Int?     // Em GB

  isActive        Boolean  @default(true)
  stripePriceId   String?  @unique

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relações
  subscriptions Subscription[]
  orders        Order[]

  @@map("plans")
}

enum BillingPeriod {
  MONTHLY
  YEARLY
}

model Subscription {
  id                    String            @id @default(cuid())
  userId                String
  planId                String
  status                SubscriptionStatus @default(ACTIVE)

  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  cancelAtPeriodEnd     Boolean           @default(false)
  canceledAt            DateTime?

  stripeSubscriptionId  String?           @unique
  stripeCustomerId      String?

  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  // Relações
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  PAST_DUE
  UNPAID
  TRIALING
}

model Order {
  id              String       @id @default(cuid())
  userId          String
  planId          String
  amount          Decimal      @db.Decimal(10, 2)
  status          OrderStatus  @default(PENDING)
  paymentMethod   String?

  stripePaymentIntentId String? @unique
  stripeInvoiceId       String? @unique

  paidAt          DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Relações
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id])

  @@map("orders")
}

enum OrderStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}

// ===== BLOG =====

model Post {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  excerpt     String?
  content     String      @db.Text
  coverImage  String?

  authorId    String
  categoryId  String?

  status      PostStatus  @default(DRAFT)
  publishedAt DateTime?

  views       Int         @default(0)

  // SEO
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relações
  author   User      @relation("PostAuthor", fields: [authorId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])
  tags     TagOnPost[]

  @@index([slug])
  @@index([status, publishedAt])
  @@map("posts")
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relações
  posts Post[]

  @@map("categories")
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relações
  posts TagOnPost[]

  @@map("tags")
}

model TagOnPost {
  postId String
  tagId  String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("tags_on_posts")
}

// ===== SUPORTE =====

model SupportTicket {
  id       String         @id @default(cuid())
  userId   String
  subject  String
  message  String         @db.Text
  status   TicketStatus   @default(OPEN)
  priority TicketPriority @default(MEDIUM)

  assignedTo String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  closedAt  DateTime?

  // Relações
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies TicketReply[]

  @@map("support_tickets")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model TicketReply {
  id       String   @id @default(cuid())
  ticketId String
  userId   String   // Pode ser cliente ou agente
  message  String   @db.Text
  isStaff  Boolean  @default(false)

  createdAt DateTime @default(now())

  // Relações
  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_replies")
}

// ===== CUPONS/DESCONTOS =====

model Coupon {
  id              String      @id @default(cuid())
  code            String      @unique
  description     String?
  discountType    DiscountType
  discountValue   Decimal     @db.Decimal(10, 2)

  maxUses         Int?
  usedCount       Int         @default(0)

  validFrom       DateTime
  validUntil      DateTime?

  isActive        Boolean     @default(true)

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@map("coupons")
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_TRIAL
}

// Notificações In-App
model Notification {
  id          String             @id @default(cuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  type        NotificationType
  title       String
  message     String             @db.Text
  link        String?
  metadata    Json?              // Dados adicionais da notificação

  isRead      Boolean            @default(false)
  readAt      DateTime?

  createdAt   DateTime           @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  PAYMENT
  SUBSCRIPTION
  SUPPORT
  SYSTEM
}

// ===== MÓDULOS ERP =====

// Clientes
model Customer {
  id            String   @id @default(cuid())
  name          String
  email         String?  @unique
  phone         String?
  cpfCnpj       String?  @unique
  type          CustomerType @default(PESSOA_FISICA)

  // Endereço
  address       String?  // Logradouro
  numero        String?
  complemento   String?
  bairro        String?
  city          String?
  state         String?
  zipCode       String?

  // --- Destinatário da NF-e ---
  inscricaoEstadual   String?
  indIEDest           IndicadorIeDestinatario?
  codigoMunicipioIBGE String?  // não dá para deduzir de city+state com segurança

  // Metadata
  notes         String?  @db.Text
  isActive      Boolean  @default(true)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relações
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  salesOrders   SalesOrder[]
  financialTransactions FinancialTransaction[]

  @@map("customers")
}

enum CustomerType {
  PESSOA_FISICA
  PESSOA_JURIDICA
}

/// indIEDest da NF-e: 1, 2 e 9 respectivamente.
enum IndicadorIeDestinatario {
  CONTRIBUINTE
  ISENTO
  NAO_CONTRIBUINTE
}

// Produtos
model Product {
  id            String   @id @default(cuid())
  name          String
  sku           String?  @unique
  description   String?  @db.Text

  type          ProductType @default(PRODUCT)
  category      String?

  // Preços
  price         Decimal  @db.Decimal(10, 2)
  cost          Decimal? @db.Decimal(10, 2)

  // Estoque
  stockQuantity Int      @default(0)
  minStock      Int      @default(0)
  unit          String   @default("UN")

  // --- Tributação da NF-e ---
  // Sem NCM não sai nota. `cfop` e `origem` têm default porque cobrem a venda
  // dentro do estado de mercadoria nacional — o caso da esmagadora maioria.
  ncm               String?  // 8 dígitos
  cest              String?  // só quando há substituição tributária
  cfop              String?  @default("5102")
  origem            String?  @default("0")
  csosn             String?  // Simples Nacional
  cstIcms           String?  // Regime Normal
  cstPisCofins      String?
  aliquotaIcms      Decimal? @db.Decimal(5, 2)
  unidadeTributavel String?  // default: cai no `unit`

  // Metadata
  isActive      Boolean  @default(true)
  image         String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relações
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  orderItems    OrderItem[]

  @@map("products")
}

enum ProductType {
  PRODUCT
  SERVICE
}

// Pedidos de Venda
model SalesOrder {
  id              String        @id @default(cuid())
  orderNumber     String        @unique

  // Cliente
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id])

  // Valores
  subtotal        Decimal       @db.Decimal(10, 2)
  discount        Decimal       @default(0) @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)

  // Status
  status          SalesOrderStatus   @default(DRAFT)
  paymentStatus   PaymentStatus @default(PENDING)

  // Datas
  orderDate       DateTime      @default(now())
  dueDate         DateTime?
  paidAt          DateTime?

  // Observações
  notes           String?       @db.Text

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relações
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  items           OrderItem[]
  financialTransactions FinancialTransaction[]
  notasFiscais    NotaFiscal[]

  @@map("sales_orders")
}

// Uma nota por tentativa de emissão: uma rejeitada não vira autorizada, o
// cliente corrige e emite de novo. Por isso é lista, não 1:1.
model NotaFiscal {
  id          String     @id @default(cuid())

  orderId     String
  order       SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId      String
  user        User       @relation(fields: [userId], references: [id])

  // A SEFAZ leva de segundos a minutos e pode rejeitar: nasce PENDENTE e o
  // webhook do provedor é quem fecha o status. Nada disso é await na tela.
  status      NotaFiscalStatus @default(PENDENTE)
  ambiente    AmbienteFiscal   @default(HOMOLOGACAO)

  numero      Int?
  serie       Int?
  chaveAcesso String?    @unique  // 44 dígitos
  protocolo   String?
  xmlUrl      String?
  danfeUrl    String?

  // Referência do documento no provedor. @unique porque o webhook reentrega o
  // mesmo evento — mesmo motivo do stripeInvoiceId no G2.
  providerRef String?    @unique
  motivoRejeicao String? @db.Text

  emitidaEm   DateTime?
  canceladaEm DateTime?
  justificativaCancelamento String? @db.Text

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([orderId])
  @@index([userId])
  @@map("notas_fiscais")
}

enum NotaFiscalStatus {
  PENDENTE
  AUTORIZADA
  REJEITADA
  CANCELADA
}

model OrderItem {
  id          String      @id @default(cuid())

  orderId     String
  order       SalesOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId   String
  product     Product     @relation(fields: [productId], references: [id])

  quantity    Int
  unitPrice   Decimal     @db.Decimal(10, 2)
  total       Decimal     @db.Decimal(10, 2)

  @@map("order_items")
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

// Financeiro
model FinancialTransaction {
  id              String              @id @default(cuid())

  type            TransactionType
  category        String
  description     String

  amount          Decimal             @db.Decimal(10, 2)

  // Relacionamentos
  customerId      String?
  customer        Customer?           @relation(fields: [customerId], references: [id])

  orderId         String?
  order           SalesOrder?         @relation(fields: [orderId], references: [id])

  // Datas
  dueDate         DateTime
  paidAt          DateTime?

  status          FinancialStatus     @default(PENDING)

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  userId          String
  user            User                @relation(fields: [userId], references: [id])

  @@map("financial_transactions")
}

enum TransactionType {
  RECEIVABLE
  PAYABLE
}

enum FinancialStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

// ===== ONBOARDING & MIGRAÇÃO =====

// Onboarding do usuário (acompanhamento de progresso)
model UserOnboarding {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Progresso de onboarding (checklist)
  completedSteps Json    @default("[]") // Array de step IDs completados
  currentStep    String? // Step atual em progresso

  // Steps disponíveis:
  // 1. welcome - Boas-vindas e tour inicial
  // 2. company_setup - Configurar dados da empresa
  // 3. fiscal_setup - Configurar dados fiscais (CNPJ, regime tributário)
  // 4. first_product - Cadastrar primeiro produto
  // 5. first_customer - Cadastrar primeiro cliente
  // 6. first_sale - Criar primeira venda
  // 7. migration - Migrar dados de outro ERP (opcional)
  // 8. integrations - Conectar integrações (opcional)
  // 9. completed - Onboarding concluído

  isCompleted   Boolean  @default(false)
  completedAt   DateTime?

  // Preferências do usuário
  skipTour      Boolean  @default(false)
  skipMigration Boolean  @default(false)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("user_onboarding")
}

// Migração de dados de concorrentes
model DataMigration {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  sourceErp       SourceErp         // ERP de origem (Omie, Bling, Tiny, etc)
  status          MigrationStatus   @default(PENDING)

  // Dados da migração
  fileName        String?           // Nome do arquivo original
  fileSize        Int?              // Tamanho em bytes
  fileType        String?           // csv, xlsx, json

  // Mapeamento de entidades
  entitiesMapping Json?             // Mapeamento de campos customizado

  // Estatísticas
  totalRecords    Int               @default(0)
  processedRecords Int              @default(0)
  successRecords  Int               @default(0)
  errorRecords    Int               @default(0)

  // Logs e erros
  errors          Json?             // Array de erros encontrados
  warnings        Json?             // Array de avisos

  // Datas
  startedAt       DateTime?
  completedAt     DateTime?

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([userId, status])
  @@map("data_migrations")
}

enum SourceErp {
  OMIE
  BLING
  TINY
  CONTA_AZUL
  SAP
  TOTVS
  OTHER
}

enum MigrationStatus {
  PENDING       // Aguardando início
  VALIDATING    // Validando arquivo
  PROCESSING    // Processando dados
  COMPLETED     // Concluído com sucesso
  FAILED        // Falhou
  PARTIAL       // Concluído com erros parciais
}

// ===== WEB PUSH NOTIFICATIONS =====

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint  String   @unique
  p256dh    String   // Chave pública para criptografia
  auth      String   // Chave de autenticação

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("push_subscriptions")
}

// ===== API KEYS =====

model ApiKey {
  id           String    @id @default(cuid())
  name         String    // Nome amigável (ex: "Chave de Produção")
  keyHash      String    @unique // bcrypt hash da API key
  keyPrefix    String    // Primeiros 12 caracteres para identificação (ex: "sk_live_1234")
  lastUsed     DateTime?
  expiresAt    DateTime?
  requestCount Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyPrefix])
  @@map("api_keys")
}

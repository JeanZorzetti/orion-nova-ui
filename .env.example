# Database (Supabase ou Neon)
# IMPORTANTE: Crie um arquivo .env.local e substitua pelos valores reais
# Supabase: postgresql://postgres:[SUA-SENHA]@[SEU-HOST].supabase.co:5432/postgres
# Neon: postgresql://[USER]:[PASSWORD]@[HOST].neon.tech/[DATABASE]?sslmode=require
DATABASE_URL="postgresql://postgres:senha@localhost:5432/orion_dev"

# NextAuth
# Gere uma secret aleatória com: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl"
NEXTAUTH_URL="http://localhost:3000"

# Stripe
# Use uma RESTRICTED KEY (rk_), não a secret key (sk_). Permissões necessárias:
# Checkout Sessions (write), Customers (write), Subscriptions (read),
# Billing Portal Sessions (write), Prices (read).
# Crie em: https://dashboard.stripe.com/apikeys (Create restricted key)
# Na Vercel, marque como Sensitive Environment Variable.
STRIPE_SECRET_KEY="rk_test_..."

# Segredo de assinatura do webhook (whsec_). Um por endpoint/ambiente.
# Local: `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# Produção: https://dashboard.stripe.com/webhooks → endpoint
#   https://orion.roilabs.com.br/api/webhooks/stripe
#   eventos: checkout.session.completed, customer.subscription.updated,
#            customer.subscription.deleted
STRIPE_WEBHOOK_SECRET="whsec_..."

# Seed (prisma/seed.ts). Sem estas, o seed gera senhas aleatórias e as imprime.
# Só valem na criação do usuário: o upsert não altera quem já existe.
SEED_ADMIN_PASSWORD=""
SEED_OWNER_PASSWORD=""

# Google OAuth (Dia 2 - opcional)
# Obtenha em: https://console.cloud.google.com/
# GOOGLE_CLIENT_ID="..."
# GOOGLE_CLIENT_SECRET="..."

# Email (Resend)
# Obtenha em: https://resend.com/api-keys
RESEND_API_KEY="re_..."
EMAIL_FROM="Orion ERP <noreply@orion.roilabs.com.br>"
# Destino dos leads de /contato. Sem ela cai em contato@orion.roilabs.com.br.
LEAD_EMAIL=

# CRM do ROI Hub. Ausentes = /api/contact só manda o e-mail e segue — o lead
# não se perde, só não vira card. O segredo é PRÓPRIO da ingestão: não é o
# CRON_SECRET do autopublishing.
CRM_INGEST_URL="https://hub.roilabs.com.br/api/crm/leads"
CRM_INGEST_SECRET=

# Groq AI
# Obtenha em: https://console.groq.com/
GROQ_API_KEY="gsk_..."

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Base URL (usado para SEO, sitemap, etc.)
NEXT_PUBLIC_BASE_URL="https://orion.roilabs.com.br"

# Google Analytics 4
# Obtenha em: https://analytics.google.com/
# Formato: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"

# Google Tag Manager
# Obtenha em: https://tagmanager.google.com/
# Formato: GTM-XXXXXXX
NEXT_PUBLIC_GTM_ID="GTM-XXXXXXX"

# Sentry Error Monitoring
# Obtenha em: https://sentry.io/
NEXT_PUBLIC_SENTRY_DSN="https://xxxxx@xxxxx.ingest.sentry.io/xxxxx"
SENTRY_ORG="your-org"
SENTRY_PROJECT="orion-erp"
SENTRY_AUTH_TOKEN="sntrys_..."
